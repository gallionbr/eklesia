NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# ── Dízimo pelo WhatsApp (opcional; sem isto o app segue com o Pix estático)
NEXT_PUBLIC_DIZIMO_WHATSAPP=0            # 1 mostra o cartão "Pelo WhatsApp" em Ofertas
SUPABASE_SERVICE_ROLE_KEY=               # Supabase → Settings → API (secreta: só na Vercel)
WA_NUMERO=5585900000000                  # número da igreja no WhatsApp, só dígitos com 55
WA_PHONE_NUMBER_ID=                      # Meta → WhatsApp → API Setup
WA_ACCESS_TOKEN=                         # token permanente de usuário do sistema (Business Manager)
WA_APP_SECRET=                           # Meta → App → Settings → Basic → App Secret
WA_VERIFY_TOKEN=                         # invente um texto; o mesmo vai na config do webhook
WA_GRAPH_VERSION=v23.0
ASAAS_API_KEY=                           # Asaas → Integrações → Chave de API
ASAAS_WEBHOOK_TOKEN=                     # invente 32+ caracteres; o mesmo vai no webhook do Asaas
ASAAS_API_URL=https://api-sandbox.asaas.com/v3   # produção: https://api.asaas.com/v3
